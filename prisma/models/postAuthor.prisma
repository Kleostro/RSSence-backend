model PostAuthor {
  postId         Int     @map("post_id")
  authorUsername String  @map("author_username")
  isMainAuthor   Boolean @default(false) @map("is_main_author")

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorUsername], references: [username], onDelete: Cascade)

  @@id([postId, authorUsername])
  @@map("post_authors")
}
