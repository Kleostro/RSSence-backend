model PostCoauthor {
  postId Int  @map("post_id")
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId Int    @map("author_id")
  author   Author @relation(fields: [authorId], references: [userId], onDelete: Cascade)

  @@id([postId, authorId])
  @@map("post_coauthors")
}
