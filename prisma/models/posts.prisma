model Post {
  id      Int     @id @default(autoincrement())
  title   String
  content String

  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  status    PostStatus @default(DRAFT)

  authors     PostAuthor[]
  postHistory PostHistory[]

  @@map("posts")
}

enum PostStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REVISION_REQUIRED
  REJECTED
}

enum PostActionType {
  POST_CREATED
  POST_UPDATED
  POST_SUBMITTED
  MODERATION_STATUS_CHANGED
}
