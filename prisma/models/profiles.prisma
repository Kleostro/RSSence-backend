model Profile {
  id Int @id @default(autoincrement())

  firstname String
  lastname  String
  username  String    @unique
  bio       String?
  avatarUrl String?   @map("avatar_url")
  birthdate DateTime?

  user User? @relation

  author         Author? @relation("AuthorToProfile", fields: [authorUsername], references: [username])
  authorUsername String? @unique @map("author_username")

  @@map("profiles")
}
