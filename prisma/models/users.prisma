model User {
  id Int @id @default(autoincrement())

  email          String @unique
  hashedPassword String @map("hashed_password")

  roles UserRole[]

  profile Profile?
  author  Author?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}
