model User {
  id Int @id @default(autoincrement())

  email          String @unique
  hashedPassword String @map("hashed_password")

  roles UserRole[]

  profile         Profile? @relation(fields: [profileUsername], references: [username], onDelete: Cascade)
  profileUsername String?  @unique @map("profile_username")

  moderator   Moderator? @relation("ModerationToUser", fields: [moderatorId], references: [id])
  moderatorId Int?       @unique @map("moderator_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}
