model User {
  id Int @id @default(autoincrement())

  email          String @unique
  hashedPassword String @map("hashed_password")

  profile Profile?
  author  Author?
  roles   UserRole[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Profile {
  firstname String
  lastname  String
  username  String    @unique
  bio       String?
  avatarUrl String?   @map("avatar_url")
  birthdate DateTime?

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Author {
  id Int @id @default(autoincrement())

  username  String    @unique
  bio       String?
  avatarUrl String?   @map("avatar_url")

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  authoredPosts Post[] @relation("AuthorProfile")

  coauthoredPosts PostCoauthor[]

  @@map("authors")
}

model Role {
  id    Int        @id @default(autoincrement())
  name  String     @unique
  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId Int  @map("user_id")
  roleId Int  @map("role_id")
  user   User @relation(fields: [userId], references: [id])
  role   Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("users_roles")
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  imageUrls String[] @default([]) @map("image_urls")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  authorId Int    @map("author_id")
  author   Author @relation("AuthorProfile", fields: [authorId], references: [userId])

  coauthors PostCoauthor[]

  @@map("posts")
}

model PostCoauthor {
  postId Int  @map("post_id")
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId Int    @map("author_id")
  author   Author @relation(fields: [authorId], references: [userId], onDelete: Cascade)

  @@id([postId, authorId])
  @@map("post_coauthors")
}
